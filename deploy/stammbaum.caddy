# stammbaum.p-m-pott.de — Cloudflare Proxy (HTTP only)
# Static pages: /srv/projects/stammbaum/public  →  stammbaum-web (nginx)
# API + data:                                   →  stammbaum-api (Node/SQLite)
stammbaum.p-m-pott.de:80 {
    encode gzip zstd
    handle /api/* {
        reverse_proxy stammbaum-api:3000
    }
    handle {
        reverse_proxy stammbaum-web:80
    }
}
