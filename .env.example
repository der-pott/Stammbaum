# Key für KI-Ahnenforschung. Auf dem VPS unter /srv/projects/stammbaum/.env ablegen,
# NIEMALS ins Repo einchecken.
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE-ME
# Optional: anderes Modell wählen (Standard: claude-opus-4-7).
# ANTHROPIC_MODEL=claude-opus-4-7

# PIN-Auth: beim ersten Start werden diese PINs in die Datenbank übernommen
# (gehasht mit scrypt+Salt). Spätere Änderungen hier haben keine Wirkung mehr;
# die PINs leben dann in der SQLite-Datei. Zum Zurücksetzen: Zeile aus Tabelle
# `pins` löschen und Container neu starten.
SB_INIT_EDITOR_PIN=change-me-editor
SB_INIT_VIEWER_PIN=change-me-viewer
