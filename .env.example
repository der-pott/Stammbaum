# Key für KI-Ahnenforschung. Auf dem VPS unter /srv/projects/stammbaum/.env ablegen,
# NIEMALS ins Repo einchecken.
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE-ME
# Optional: anderes Modell wählen (Standard: claude-opus-4-7).
# ANTHROPIC_MODEL=claude-opus-4-7

# PIN-Auth: beim ersten Start werden diese PINs in die Datenbank übernommen
# (gehasht mit scrypt+Salt). Spätere Änderungen hier haben keine Wirkung mehr;
# die PINs leben dann in der SQLite-Datei. Zum Zurücksetzen: Zeile aus Tabelle
# `pins` löschen und Container neu starten.
SB_INIT_EDITOR_PIN=change-me-editor
SB_INIT_VIEWER_PIN=change-me-viewer

# ---------------------------------------------------------------------
# Web-Search Backend (für Quellen: Web, LinkedIn, Xing, Presse)
# ---------------------------------------------------------------------
# Setze EINE dieser Varianten. Ohne Backend liefern diese Quellen
# "Konfiguration fehlt"-Karten (keine Treffer).
#
# Brave Search API — kostenlos, 2000 Queries/Monat, keine Kreditkarte:
#   https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=
#
# Serper.dev (Google-Proxy) — bezahlt, qualitativ oft besser:
#   https://serper.dev/
SERPER_API_KEY=

# ---------------------------------------------------------------------
# Optional: Google Custom Search Engine (eigene Quelle "Google via CSE")
# 100 Queries/Tag kostenlos. Zusätzlich zu Brave/Serper nutzbar.
#   https://developers.google.com/custom-search/v1/overview
#   https://programmablesearchengine.google.com/
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# Optional: Google Books API-Key (free, 1000/Tag) — gegen Rate-Limits:
#   https://developers.google.com/books/docs/v1/using#APIKey
GOOGLE_BOOKS_API_KEY=

# Optional: Deutsche Digitale Bibliothek — höhere Rate mit Key:
#   https://www.deutsche-digitale-bibliothek.de/user/apikey
DDB_API_KEY=

# ---------------------------------------------------------------------
# Scrape-Backend (optional, aktiviert robuste HTML-Scraper)
# ---------------------------------------------------------------------
# Firecrawl-Self-Hosted-URL. Wenn gesetzt, laufen alle HTML-Scraper
# (zefys, zlb_adressbuecher, landesarchiv_berlin, trauer, gedenkseiten,
# onlinegedenken, geneanet, matricula etc.) ueber Firecrawl → Playwright-
# Browser → umgeht die meisten IP-Blocks.
# FIRECRAWL_URL=https://firecrawl.p-m-pott.de
# FIRECRAWL_API_KEY=change-me

# ---------------------------------------------------------------------
# Europeana (optional, EU-Kulturerbe-API)
# ---------------------------------------------------------------------
# Kostenlos registrieren: https://pro.europeana.eu/get-api
# EUROPEANA_API_KEY=change-me
